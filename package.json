{
  "name": "wp-theme-makotokw",
  "version": "0.9",
  "description": "makotokw theme for WordPress",
  "license": "GPL-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/makotokw/wp-theme-makotokw"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.1",
    "clipboard": "^2.0.8",
    "google-code-prettify": "1.0.5",
    "headroom.js": "0.12.0",
    "notyf": "^3.9.0",
    "smooth-scroll": "16.1.3",
    "tippy.js": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "autoprefixer": "^10.1.0",
    "ejs": "^3.1.5",
    "eslint": "^9.35.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "postcss": "^8.2.1",
    "sass": "^1.77.0",
    "vite": "^7.0.0"
  },
  "scripts": {
    "lint:eslint": "eslint src *.config.js",
    "lint:phpcs": "phpcs",
    "build": "vite build",
    "build:dev": "vite build --minify false",
    "dev": "vite",
    "lang:1st-pot": "wp i18n make-pot ./ languages/messages.pot",
    "lang:2nd-mo": "msgfmt -o ./languages/ja.mo ./languages/ja.po"
  }
}
