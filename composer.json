{
    "name": "makotokw/wp-makotokw-theme",
    "type": "wordpress-theme",
    "description": "WordPress theme for blog.makotokw.com",
    "keywords": [
      "WordPress",
      "Themes"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
      {
        "name": "Makoto Kawasaki",
        "email": "makoto.kw@gmail.com",
        "homepage": "https://makotokw.com"
      }
    ],
    "require": {
      "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "php-parallel-lint/php-parallel-lint": "^1.2.0",
        "wp-cli/i18n-command": "^2.2.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
      "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
      "lint:phpcs": "@php ./vendor/bin/phpcs",
      "make-pot": "./vendor/bin/wp i18n make-pot . languages/messages.pot --exclude=vendor,node_modules,dist --allow-root",
      "merge-po": "msgmerge --update languages/ja.po languages/messages.pot",
      "make-mo": "./vendor/bin/wp i18n make-mo languages/ja.po --allow-root"
    }
}
